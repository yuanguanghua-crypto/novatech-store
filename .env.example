# Environment Variables Template
# Copy this file to .env.local and fill in actual values

# ==============================
# Database (AWS RDS PostgreSQL)
# ==============================
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/novatech_store"

# ==============================
# NextAuth.js
# ==============================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="novatech_secret_key_2024"

# ==============================
# OAuth Providers
# ==============================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==============================
# Stripe Payment
# ==============================
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==============================
# AWS S3 (Product Images)
# ==============================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="novatech-store-images"
AWS_CLOUDFRONT_URL="https://your-distribution.cloudfront.net"

# ==============================
# Email (AWS SES or SendGrid)
# ==============================
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_SERVER_HOST="email-smtp.us-east-1.amazonaws.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="ses-smtp-user"
EMAIL_SERVER_PASSWORD="ses-smtp-password"

# ==============================
# App Settings
# ==============================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NovatechStore"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ==============================
# Admin
# ==============================
ADMIN_EMAIL="admin@yourdomain.com"
